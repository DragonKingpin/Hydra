<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.pinecone.hydra.task.ibatis.TaskNamespaceMapper">

    <resultMap id="TaskNamespaceMap" type="com.pinecone.hydra.task.kom.entity.GenericNamespace">
        <id     column="id"   property="enumId"/>
        <result column="guid" property="guid"/>
        <result column="name" property="name"/>
    </resultMap>

    <insert id="insert" parameterType="com.pinecone.hydra.task.kom.entity.Namespace">
        INSERT INTO `hydra_task_namespace_node`
        (
            `guid`,
            `name`
        )
        VALUES
        (
            #{guid},
            #{name}
        )
    </insert>

    <delete id="remove">
        DELETE FROM `hydra_task_namespace_node`
        WHERE `guid` = #{guid}
    </delete>

    <select id="getNamespace" resultMap="TaskNamespaceMap">
        SELECT
            `id`,
            `guid`,
            `name`
        FROM `hydra_task_namespace_node`
        WHERE `guid` = #{guid}
    </select>

    <update id="update" parameterType="com.pinecone.hydra.task.kom.entity.Namespace">
        UPDATE `hydra_task_namespace_node`
        SET
            `name` = #{name}
        WHERE `guid` = #{guid}
    </update>

    <select id="fetchNamespaceNodeByName0" resultMap="TaskNamespaceMap">
        SELECT
            `id`,
            `guid`,
            `name`
        FROM `hydra_task_namespace_node`
        WHERE `name` = #{name}
    </select>

    <select id="getGuidsByName" resultType="com.pinecone.framework.util.id.GUID">
        SELECT
            `guid`
        FROM `hydra_task_namespace_node`
        WHERE `name` = #{name}
    </select>

    <select id="getGuidsByNameID" resultType="com.pinecone.framework.util.id.GUID">
        SELECT
            `guid`
        FROM `hydra_task_namespace_node`
        WHERE `name` = #{name}
          AND `guid` = #{guid}
    </select>

</mapper>
