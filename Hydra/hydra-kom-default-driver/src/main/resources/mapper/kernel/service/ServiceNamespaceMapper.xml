<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.pinecone.hydra.service.ibatis.ServiceNamespaceMapper">

    <resultMap id="NamespaceMap" type="com.pinecone.hydra.service.kom.entity.GenericNamespace">
        <id     column="id"                 property="enumId"/>
        <result column="guid"               property="guid"/>
        <result column="name"               property="name"/>
        <result column="description"        property="description"/>
        <result column="extra_information"  property="extraInformation"/>
        <result column="create_time"        property="createTime"/>
        <result column="update_time"        property="updateTime"/>
    </resultMap>

    <sql id="NamespaceFields">
        `id`,
        `guid`,
        `name`,
        `description`,
        `extra_information`,
        `create_time`,
        `update_time`
    </sql>

    <insert id="insert" parameterType="com.pinecone.hydra.service.kom.entity.Namespace">
        INSERT INTO `hydra_service_namespace_node`
        (
            `guid`,
            `name`,
            `description`,
            `extra_information`
        )
        VALUES
        (
            #{guid},
            #{name},
            #{description},
            #{extraInformation}
        )
    </insert>

    <delete id="remove">
        DELETE FROM `hydra_service_namespace_node`
        WHERE `guid` = #{guid}
    </delete>

    <select id="getNamespace" resultMap="NamespaceMap">
        SELECT
        <include refid="NamespaceFields"/>
        FROM `hydra_service_namespace_node`
        WHERE `guid` = #{guid}
    </select>

    <update id="update" parameterType="com.pinecone.hydra.service.kom.entity.Namespace">
        UPDATE `hydra_service_namespace_node`
        SET
            `name` = #{name},
            `description` = #{description},
            `extra_information` = #{extraInformation}
        WHERE `guid` = #{guid}
    </update>

    <select id="fetchNamespaceNodeByName0" resultMap="NamespaceMap">
        SELECT
        <include refid="NamespaceFields"/>
        FROM `hydra_service_namespace_node`
        WHERE `name` = #{name}
    </select>

    <select id="getGuidsByName" resultType="com.pinecone.framework.util.id.GUID">
        SELECT
            `guid`
        FROM `hydra_service_namespace_node`
        WHERE `name` = #{name}
    </select>

    <select id="getGuidsByNameID" resultType="com.pinecone.framework.util.id.GUID">
        SELECT
            `guid`
        FROM `hydra_service_namespace_node`
        WHERE `name` = #{name}
        AND `guid` != #{guid}
    </select>

</mapper>
