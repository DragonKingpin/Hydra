<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.pinecone.hydra.service.ibatis.ServiceNodeMetaMapper">

    <resultMap id="NodeMetaMap" type="com.pinecone.hydra.service.kom.entity.GenericCommonMeta">
        <id     column="id"                  property="enumId"/>
        <result column="guid"                property="guid"/>
        <result column="scenario"            property="scenario"/>
        <result column="primary_impl_lang"   property="primaryImplLang"/>
        <result column="extra_information"   property="extraInformation"/>
        <result column="level"               property="level"/>
        <result column="description"         property="description"/>
    </resultMap>

    <insert id="insert" parameterType="com.pinecone.hydra.service.kom.ServiceFamilyNode">
        INSERT INTO `hydra_service_node_meta`
        (
            `guid`,
            `scenario`,
            `primary_impl_lang`,
            `extra_information`,
            `level`,
            `description`
        )
        VALUES
        (
            #{guid},
            #{scenario},
            #{primaryImplLang},
            #{extraInformation},
            #{level},
            #{description}
        )
    </insert>

    <insert id="insertNS" parameterType="com.pinecone.hydra.service.kom.entity.Namespace">
        INSERT INTO `hydra_service_node_meta`
        (
            `guid`,
            `scenario`,
            `primary_impl_lang`,
            `extra_information`,
            `level`,
            `description`
        )
        VALUES
        (
            #{metaGuid},
            #{scenario},
            #{primaryImplLang},
            #{extraInformation},
            #{level},
            #{description}
        )
    </insert>

    <delete id="remove">
        DELETE FROM `hydra_service_node_meta`
        WHERE `guid` = #{guid}
    </delete>

    <select id="getNodeCommonMeta" resultMap="NodeMetaMap">
        SELECT
            `id`,
            `guid`,
            `scenario`,
            `primary_impl_lang`,
            `extra_information`,
            `level`,
            `description`
        FROM `hydra_service_node_meta`
        WHERE `guid` = #{guid}
    </select>

    <update id="update" parameterType="com.pinecone.hydra.service.kom.ServiceFamilyNode">
        UPDATE `hydra_service_node_meta`
        SET
            `scenario` = #{scenario},
            `primary_impl_lang` = #{primaryImplLang},
            `extra_information` = #{extraInformation},
            `level` = #{level},
            `description` = #{description}
        WHERE `guid` = #{guid}
    </update>

    <update id="updateScenario">
        UPDATE `hydra_service_node_meta`
        SET `scenario` = #{scenario}
        WHERE `guid` = #{guid}
    </update>

    <update id="updatePrimaryImplLang">
        UPDATE `hydra_service_node_meta`
        SET `primary_impl_lang` = #{primaryImplLang}
        WHERE `guid` = #{guid}
    </update>

    <update id="updateExtraInformation">
        UPDATE `hydra_service_node_meta`
        SET `extra_information` = #{extraInformation}
        WHERE `guid` = #{guid}
    </update>

    <update id="updateLevel">
        UPDATE `hydra_service_node_meta`
        SET `level` = #{level}
        WHERE `guid` = #{guid}
    </update>

    <update id="updateDescription">
        UPDATE `hydra_service_node_meta`
        SET `description` = #{description}
        WHERE `guid` = #{guid}
    </update>

</mapper>
