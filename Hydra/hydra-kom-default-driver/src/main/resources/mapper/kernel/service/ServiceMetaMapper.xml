<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.pinecone.hydra.service.ibatis.ServiceMetaMapper">

    <resultMap id="ServiceMetaMap" type="com.pinecone.hydra.service.kom.entity.GenericServiceElement">
        <id     column="id"             property="enumId"/>
        <result column="guid"           property="guid"/>
        <result column="name"           property="name"/>
        <result column="path"           property="path"/>
        <result column="type"           property="type"/>
        <result column="alias"          property="alias"/>
        <result column="resource_type"  property="resourceType"/>
        <result column="service_type"   property="serviceType"/>
        <result column="create_time"    property="createTime"/>
        <result column="update_time"    property="updateTime"/>
    </resultMap>

    <insert id="insert" parameterType="com.pinecone.hydra.service.kom.entity.ServiceElement">
        INSERT INTO `hydra_service_serv_node_meta`
        (
            `guid`,
            `name`,
            `path`,
            `type`,
            `alias`,
            `resource_type`,
            `service_type`,
            `create_time`,
            `update_time`
        )
        VALUES
        (
            #{metaGuid},
            #{name},
            #{path},
            #{type},
            #{alias},
            #{resourceType},
            #{serviceType},
            #{createTime},
            #{updateTime}
        )
    </insert>

    <delete id="remove">
        DELETE FROM `hydra_service_serv_node_meta`
        WHERE `guid` = #{guid}
    </delete>

    <select id="getServiceMeta" resultMap="ServiceMetaMap">
        SELECT
            `id`,
            `guid`,
            `name`,
            `path`,
            `type`,
            `alias`,
            `resource_type`,
            `service_type`,
            `create_time`,
            `update_time`
        FROM `hydra_service_serv_node_meta`
        WHERE `guid` = #{guid}
    </select>

    <update id="update" parameterType="com.pinecone.hydra.service.kom.entity.ServiceElement">
        UPDATE `hydra_service_serv_node_meta`
        SET
            `name` = #{name},
            `path` = #{path},
            `type` = #{type},
            `alias` = #{alias},
            `resource_type` = #{resourceType},
            `service_type` = #{serviceType},
            `update_time` = #{updateTime}
        WHERE `guid` = #{guid}
    </update>

    <update id="updateName">
        UPDATE `hydra_service_serv_node_meta`
        SET `name` = #{name}
        WHERE `guid` = #{guid}
    </update>

    <update id="updatePath">
        UPDATE `hydra_service_serv_node_meta`
        SET `path` = #{path}
        WHERE `guid` = #{guid}
    </update>

    <update id="updateAlias">
        UPDATE `hydra_service_serv_node_meta`
        SET `alias` = #{alias}
        WHERE `guid` = #{guid}
    </update>

    <update id="updateResourceType">
        UPDATE `hydra_service_serv_node_meta`
        SET `resource_type` = #{resourceType}
        WHERE `guid` = #{guid}
    </update>

    <update id="updateServiceType">
        UPDATE `hydra_service_serv_node_meta`
        SET `service_type` = #{serviceType}
        WHERE `guid` = #{guid}
    </update>

    <update id="updateUpdateTime">
        UPDATE `hydra_service_serv_node_meta`
        SET `update_time` = #{updateTime}
        WHERE `guid` = #{guid}
    </update>

</mapper>
