<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.pinecone.hydra.business.ibatis.PathMapper">

    <resultMap id="PathMap" type="com.pinecone.hydra.business.entity.GenericNodeCachePath">
        <id column="id" property="enumId"/>
        <result column="guid" property="guid"/>
        <result column="path" property="path"/>
        <result column="long_path" property="longPath"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <insert id="insert">
        INSERT INTO hydra_business_node_cache_path ( guid, path )
        VALUES ( #{guid}, #{path} )
    </insert>

    <insert id="insertLongPath">
        INSERT INTO hydra_business_node_cache_path ( guid, path, long_path )
        VALUES ( #{guid}, #{path}, #{longPath} )
    </insert>

    <delete id="remove">
        DELETE FROM hydra_business_node_cache_path WHERE guid = #{guid}
    </delete>

    <select id="getPath0" resultMap="PathMap">
        SELECT id, guid, path, long_path, create_time, update_time
        FROM hydra_business_node_cache_path
        WHERE guid = #{guid}
        LIMIT 1
    </select>

    <select id="queryGuidByPath" resultType="com.pinecone.framework.util.id.GUID">
        SELECT guid
        FROM hydra_business_node_cache_path
        WHERE path = #{path} OR long_path = #{path}
        LIMIT 1
    </select>

</mapper>
