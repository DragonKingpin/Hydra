<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.pinecone.hydra.file.ibatis.FolderVolumeMappingMapper">

    <insert id="insert">
        INSERT INTO `hydra_uofs_file_volume_mapping` (`folder_guid`, `volume_guid`) VALUES (#{folderGuid}, #{volumeGuid})
    </insert>

    <delete id="remove">
        DELETE FROM `hydra_uofs_file_volume_mapping` WHERE `volume_guid` = #{volumeGuid} AND `folder_guid` = #{folderGuid}
    </delete>

    <select id="getVolumeGuid" resultType="com.pinecone.framework.util.id.GUID">
        SELECT `volume_guid` FROM `hydra_uofs_file_volume_mapping` WHERE `folder_guid` = #{folderGuid}
    </select>

</mapper>
