<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.pinecone.hydra.account.ibatis.GroupNodeMapper">

    <insert id="insert">
        INSERT INTO `hydra_account_group_node`
        (
            `default_privilege_policy_guid`,
            `guid`,
            `name`
        )
        VALUES
        (
            #{defaultPrivilegePolicyGuid},
            #{guid},
            #{name}
        )
    </insert>

    <delete id="remove">
        DELETE FROM `hydra_account_group_node`
        WHERE `guid` = #{groupGuid}
    </delete>

    <select id="queryGroup" resultType="com.pinecone.hydra.account.entity.GenericGroup">
        SELECT
            `id` AS `enumId`,
            `default_privilege_policy_guid` AS `defaultPrivilegePolicyGuid`,
            `guid`,
            `name`,
            `create_time` AS `createTime`,
            `update_time` AS `updateTime`
        FROM `hydra_account_group_node`
        WHERE `guid` = #{groupGuid}
    </select>

    <select id="getGuidsByName" resultType="com.pinecone.framework.util.id.GUID">
        SELECT
            `guid`
        FROM `hydra_account_group_node`
        WHERE `name` = #{name}
    </select>

    <select id="getGuidsByNameID" resultType="com.pinecone.framework.util.id.GUID">
        SELECT
            `guid`
        FROM `hydra_account_group_node`
        WHERE `name` = #{name}
        AND `guid` = #{guid}
    </select>

    <update id="update">
        UPDATE `hydra_account_group_node`
        SET
            `default_privilege_policy_guid` = #{defaultPrivilegePolicyGuid},
            `name` = #{name}
        WHERE `guid` = #{guid}
    </update>

</mapper>
