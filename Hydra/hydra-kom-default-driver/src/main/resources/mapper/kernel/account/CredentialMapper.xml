<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.pinecone.hydra.account.ibatis.CredentialMapper">

    <insert id="insert">
        INSERT INTO `hydra_account_credential`
        (
            `guid`,
            `name`,
            `credential`,
            `create_time`,
            `update_time`,
            `type`
        )
        VALUES
        (
            #{guid},
            #{name},
            #{credential},
            #{createTime},
            #{updateTime},
            #{type}
        )
    </insert>

    <delete id="remove">
        DELETE FROM `hydra_account_credential`
        WHERE `guid` = #{credentialGuid}
    </delete>

    <select id="queryCredential" resultType="com.pinecone.hydra.account.entity.GenericCredential">
        SELECT
            `id` AS `enumId`,
            `guid`,
            `name`,
            `credential`,
            `create_time` AS `createTime`,
            `update_time` AS `updateTime`,
            `type`
        FROM `hydra_account_credential`
        WHERE `guid` = #{credentialGuid}
    </select>

</mapper>
