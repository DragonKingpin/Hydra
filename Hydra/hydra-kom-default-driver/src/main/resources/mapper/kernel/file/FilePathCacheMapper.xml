<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.pinecone.hydra.file.ibatis.FilePathCacheMapper">

    <resultMap id="BucketPathBindingMap" type="com.pinecone.hydra.unit.imperium.entity.BucketCachePathBinding">
        <id     column="id"          property="id"/>
        <result column="bucket_guid" property="bucketGuid"/>
        <result column="guid"        property="guid"/>
        <result column="path_hash"   property="pathHash"/>
        <result column="hash_slot"   property="hashSlot"/>
        <result column="path"        property="path"/>
    </resultMap>

    <delete id="remove">
        DELETE FROM `hydra_uofs_node_cache_path` WHERE `guid`=#{guid}
    </delete>

    <select id="countPathCacheByBucketGuid" resultType="long">
        SELECT COUNT( `id` ) FROM `hydra_uofs_node_cache_path` WHERE `bucket_guid` = #{bucketGuid}
    </select>

    <delete id="deletePathCacheByBucketGuid">
        DELETE FROM `hydra_uofs_node_cache_path` WHERE `bucket_guid` = #{bucketGuid}
    </delete>

    <select id="getBucketGuidByGuid" resultType="com.pinecone.framework.util.id.GUID">
        SELECT
            `bucket_guid`
        FROM `hydra_uofs_nodes`
        WHERE `guid` = #{guid}
    </select>

    <select id="listByPathHash" resultMap="BucketPathBindingMap">
        SELECT
            `id`,
            `bucket_guid`,
            `guid`,
            `path_hash`,
            `hash_slot`,
            `path`
        FROM `hydra_uofs_node_cache_path`
        WHERE `path_hash` = #{pathHash}
        ORDER BY `bucket_guid` ASC, `hash_slot` ASC
    </select>

    <select id="listByBucketAndPathHash" resultMap="BucketPathBindingMap">
        SELECT
            `id`,
            `bucket_guid`,
            `guid`,
            `path_hash`,
            `hash_slot`,
            `path`
        FROM `hydra_uofs_node_cache_path`
        WHERE `bucket_guid` = #{bucketGuid}
          AND `path_hash` = #{pathHash}
        ORDER BY `hash_slot` ASC
    </select>

    <select id="listByBucketAndPathHashForUpdate" resultMap="BucketPathBindingMap">
        SELECT
            `id`,
            `bucket_guid`,
            `guid`,
            `path_hash`,
            `hash_slot`,
            `path`
        FROM `hydra_uofs_node_cache_path`
        WHERE `bucket_guid` = #{bucketGuid}
          AND `path_hash` = #{pathHash}
        ORDER BY `hash_slot` ASC
        FOR UPDATE
    </select>

    <select id="listByGuid" resultMap="BucketPathBindingMap">
        SELECT
            `id`,
            `bucket_guid`,
            `guid`,
            `path_hash`,
            `hash_slot`,
            `path`
        FROM `hydra_uofs_node_cache_path`
        WHERE `guid` = #{guid}
        ORDER BY `path_hash` IS NULL ASC, `id` ASC
    </select>

    <select id="listByBucketAndPath" resultMap="BucketPathBindingMap">
        SELECT
            `id`,
            `bucket_guid`,
            `guid`,
            `path_hash`,
            `hash_slot`,
            `path`
        FROM `hydra_uofs_node_cache_path`
        WHERE `bucket_guid` = #{bucketGuid}
          AND `path` = #{path}
        ORDER BY `path_hash` IS NULL ASC, `id` ASC
    </select>

    <select id="listLegacyGuidsByPath" resultType="com.pinecone.framework.util.id.GUID">
        SELECT
            `guid`
        FROM `hydra_uofs_node_cache_path`
        WHERE `path` = #{path}
        ORDER BY `path_hash` IS NULL ASC, `id` ASC
    </select>

    <insert id="insertHashed">
        INSERT INTO `hydra_uofs_node_cache_path`
        (
            `bucket_guid`,
            `guid`,
            `path_hash`,
            `hash_slot`,
            `path`
        )
        VALUES
        (
            #{bucketGuid},
            #{guid},
            #{pathHash},
            #{hashSlot},
            #{path}
        )
    </insert>

    <update id="updateHashed">
        UPDATE `hydra_uofs_node_cache_path`
        SET
            `bucket_guid` = #{bucketGuid},
            `guid` = #{guid},
            `path_hash` = #{pathHash},
            `hash_slot` = #{hashSlot},
            `path` = #{path}
        WHERE `id` = #{id}
    </update>

</mapper>
