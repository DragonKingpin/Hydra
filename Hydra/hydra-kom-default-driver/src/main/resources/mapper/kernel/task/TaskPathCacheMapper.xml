<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.pinecone.hydra.task.ibatis.TaskPathCacheMapper">

    <resultMap id="TaskPathCacheMap" type="com.pinecone.hydra.unit.imperium.entity.GenericCachePath">
        <result column="path" property="path"/>
        <result column="long_path" property="longPath"/>
    </resultMap>

    <resultMap id="TaskPathBindingMap" type="com.pinecone.hydra.unit.imperium.entity.CachePathBinding">
        <id     column="id"        property="id"/>
        <result column="guid"      property="guid"/>
        <result column="path_hash" property="pathHash"/>
        <result column="hash_slot" property="hashSlot"/>
        <result column="path"      property="path"/>
        <result column="long_path" property="longPath"/>
    </resultMap>

    <insert id="insert">
        INSERT INTO `hydra_task_node_cache_path`
        (
            `path`,
            `guid`
        )
        VALUES
        (
            #{path},
            #{guid}
        )
    </insert>

    <insert id="insertLongPath">
        INSERT INTO `hydra_task_node_cache_path`
        (
            `path`,
            `long_path`,
            `guid`
        )
        VALUES
        (
            #{path},
            #{longPath},
            #{guid}
        )
    </insert>

    <delete id="remove">
        DELETE FROM `hydra_task_node_cache_path`
        WHERE `guid` = #{guid}
    </delete>

    <select id="getPath0" resultMap="TaskPathCacheMap">
        SELECT
            `path`,
            `long_path`
        FROM `hydra_task_node_cache_path`
        WHERE `guid` = #{guid}
        ORDER BY `path_hash` IS NULL ASC, `id` ASC
        LIMIT 1
    </select>

    <select id="listByPathHash" resultMap="TaskPathBindingMap">
        SELECT
            `id`,
            `guid`,
            `path_hash`,
            `hash_slot`,
            `path`,
            `long_path`
        FROM `hydra_task_node_cache_path`
        WHERE `path_hash` = #{pathHash}
        ORDER BY `hash_slot` ASC
    </select>

    <select id="listByPathHashForUpdate" resultMap="TaskPathBindingMap">
        SELECT
            `id`,
            `guid`,
            `path_hash`,
            `hash_slot`,
            `path`,
            `long_path`
        FROM `hydra_task_node_cache_path`
        WHERE `path_hash` = #{pathHash}
        ORDER BY `hash_slot` ASC
        FOR UPDATE
    </select>

    <select id="listByGuid" resultMap="TaskPathBindingMap">
        SELECT
            `id`,
            `guid`,
            `path_hash`,
            `hash_slot`,
            `path`,
            `long_path`
        FROM `hydra_task_node_cache_path`
        WHERE `guid` = #{guid}
        ORDER BY `path_hash` IS NULL ASC, `id` ASC
    </select>

    <select id="listByPath" resultMap="TaskPathBindingMap">
        SELECT
            `id`,
            `guid`,
            `path_hash`,
            `hash_slot`,
            `path`,
            `long_path`
        FROM `hydra_task_node_cache_path`
        WHERE `path` = #{path}
        ORDER BY `path_hash` IS NULL ASC, `id` ASC
    </select>

    <select id="listLegacyGuidsByPath" resultType="com.pinecone.framework.util.id.GUID">
        SELECT
            `guid`
        FROM `hydra_task_node_cache_path`
        WHERE `path` = #{path}
        ORDER BY `path_hash` IS NULL ASC, `id` ASC
    </select>

    <insert id="insertHashed">
        INSERT INTO `hydra_task_node_cache_path`
        (
            `guid`,
            `path_hash`,
            `hash_slot`,
            `path`,
            `long_path`
        )
        VALUES
        (
            #{guid},
            #{pathHash},
            #{hashSlot},
            #{path},
            #{longPath}
        )
    </insert>

    <update id="updateHashed">
        UPDATE `hydra_task_node_cache_path`
        SET
            `guid` = #{guid},
            `path_hash` = #{pathHash},
            `hash_slot` = #{hashSlot},
            `path` = #{path},
            `long_path` = #{longPath}
        WHERE `id` = #{id}
    </update>

</mapper>
