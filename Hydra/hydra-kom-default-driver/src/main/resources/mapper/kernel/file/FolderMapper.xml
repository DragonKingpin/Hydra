<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.pinecone.hydra.file.ibatis.FolderMapper">

    <insert id="insert">
        INSERT INTO `hydra_uofs_folders` (`guid`, `create_time`, `update_time`, `name`) VALUES (#{guid},#{createTime},#{updateTime},#{name})
    </insert>

    <delete id="remove">
        DELETE FROM `hydra_uofs_folders` WHERE `guid` = #{guid}
    </delete>

    <update id="update">
        UPDATE `hydra_uofs_folders` SET update_time = #{updateTime}, name = #{name} WHERE guid = #{guid}
    </update>

    <select id="getFolderByGuid" resultType="com.pinecone.hydra.storage.file.entity.GenericFolder">
        SELECT `id` AS enumId, `guid`, `create_time` AS createTime, `update_time` AS updateTime, `name` FROM `hydra_uofs_folders` WHERE `guid` = #{guid}
    </select>

    <select id="getGuidsByName" resultType="com.pinecone.framework.util.id.GUID">
        SELECT `guid` FROM `hydra_uofs_folders` WHERE `name` = #{name}
    </select>

    <select id="getGuidsByNameID" resultType="com.pinecone.framework.util.id.GUID">
        SELECT `guid` FROM `hydra_uofs_folders` WHERE `name` = #{name} AND `guid` = #{guid}
    </select>

    <select id="dumpGuid" resultType="com.pinecone.framework.util.id.GUID">
        SELECT `guid` FROM hydra_uofs_folders
    </select>

    <select id="isFolder" resultType="boolean">
        SELECT COUNT('id') FROM hydra_uofs_folders WHERE guid = #{guid}
    </select>

    <update id="rename">
        UPDATE hydra_uofs_folders SET name = #{newName} WHERE guid = #{fileGuid}
    </update>

</mapper>
