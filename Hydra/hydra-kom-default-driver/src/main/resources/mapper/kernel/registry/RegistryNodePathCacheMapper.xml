<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.pinecone.hydra.registry.ibatis.RegistryNodePathCacheMapper">

    <insert id="insert">
        INSERT INTO `hydra_registry_node_cache_path`
        (
            `path`,
            `guid`
        )
        VALUES
        (
            #{path},
            #{guid}
        )
    </insert>

    <delete id="remove">
        DELETE FROM `hydra_registry_node_cache_path`
        WHERE `guid` = #{guid}
    </delete>

    <select id="getPath" resultType="java.lang.String">
        SELECT
            `path`
        FROM `hydra_registry_node_cache_path`
        WHERE `guid` = #{guid}
    </select>

    <select id="getNode" resultType="com.pinecone.framework.util.id.GUID">
        SELECT
            `guid`
        FROM `hydra_registry_node_cache_path`
        WHERE `path` = #{path}
    </select>

    <select id="queryGUIDByPath" resultType="com.pinecone.framework.util.id.GUID">
        SELECT
            `guid`
        FROM `hydra_registry_node_cache_path`
        WHERE `path` = #{path}
    </select>

</mapper>
